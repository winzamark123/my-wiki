{
  "name": "@my-wiki/server-app",
  "private": true,
  "type": "module",
  "exports": {
    "./sources": "./src/sources.ts",
    "./wiki": "./src/wiki.ts"
  },
  "scripts": {
    "build": "wrangler deploy -c wrangler.jsonc --dry-run --outdir dist",
    "dev": "wrangler dev -c wrangler.jsonc --port 8787 --persist-to ../../.wrangler/state",
    "typecheck": "wrangler types -c wrangler.jsonc && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy -c wrangler.jsonc --minify",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "postinstall": "wrangler types -c wrangler.jsonc"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "hono": "^4.13.2",
    "marked": "^18.0.6",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
